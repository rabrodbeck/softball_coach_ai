{
  "name": "🥎 Softball Coach AI",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "src/main.py",
        "frontend/src/App.tsx"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  },
  "updateContentCommand": "[ -f packages.txt ] && sudo apt update && sudo apt upgrade -y && sudo xargs apt install -y <packages.txt; [ -f requirements.txt ] && pip3 install --user -r requirements.txt; cd frontend && npm install; echo '✅ Packages installed and Requirements met'",
  "postAttachCommand": {
    "backend": "uvicorn src.main:app --host 0.0.0.0 --port 7860"
  },
  "portsAttributes": {
    "7860": {
      "label": "FastAPI Backend",
      "onAutoForward": "silent"
    },
    "5173": {
      "label": "React Frontend",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    7860,
    5173
  ]
}